{
  "name": "@rci-tools/interfaces",
  "version": "0.1.0",
  "description": "Network interface entity model over REST Core Interface on Keenetic/Netcraze devices",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "author": "Eralde",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eralde/rci-tools.git"
  },
  "license": "ISC",
  "homepage": "https://github.com/Eralde/rci-tools#readme",
  "bugs": {
    "url": "https://github.com/Eralde/rci-tools/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup",
    "fmt": "dprint fmt 'src/**/*.ts' eslint.config.mjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "22.13.14",
    "eslint": "9.39.4",
    "eslint-plugin-jsdoc": "62.8.0",
    "tsup": "^8.5.1",
    "typescript-eslint": "8.57.1"
  },
  "dependencies": {
    "@rci-tools/core": "workspace:*",
    "lodash-es": "^4.18.1",
    "ts-mixer": "^6.0.4"
  }
}
