{
  "name": "rci-tools",
  "private": true,
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "scripts": {
    "clean": "pnpm -r run clean",
    "build:packages": "pnpm -r --filter \"./packages/*\" run build",
    "build:simple-browser-demo": "pnpm -r --filter \"./examples/simple-browser-demo\" run build",
    "build:simple-nodejs-demo": "pnpm -r --filter \"./examples/simple-nodejs-demo\" run build",
    "build:local-monitor": "pnpm -r --filter \"./examples/local-monitor\" run build",
    "build": "pnpm -r run build",
    "test:core": "pnpm --dir packages/core test",
    "test:axios": "pnpm --dir packages/adapter-axios test",
    "test:types": "pnpm -r --if-present --filter \"./packages/*\" run test:types",
    "typecheck:examples": "pnpm -r --filter \"./examples/*\" run typecheck",
    "verify": "pnpm build:packages && pnpm typecheck && pnpm test:core && pnpm test:axios && pnpm test:types && pnpm typecheck:examples",
    "typecheck": "pnpm -r --filter \"./packages/*\" run typecheck",
    "dev:simple-browser-demo": "pnpm --filter simple-browser-demo run dev",
    "dev:simple-nodejs-demo": "pnpm --filter simple-nodejs-demo run dev",
    "dev:local-monitor": "pnpm -r --filter \"./examples/local-monitor\" run dev"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "rimraf": "^5.0.10",
    "typescript": "^5.9.3",
    "vitest": "^0.34.6"
  }
}
